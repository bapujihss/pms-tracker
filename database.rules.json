{
  "rules": {
    ".read": false,
    ".write": false,
    "schools": {
      "$schoolId": {
        ".read": true,
        ".write": true
      }
    },
    "siteContent": {
      "$schoolId": {
        ".read": true,
        ".write": "auth != null && auth.token.websiteAdmin == true"
      }
    }
  }
}
